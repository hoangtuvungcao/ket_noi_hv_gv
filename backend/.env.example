# ========================================================
# tệp cấu hình mẫu biến môi trường cho máy chủ backend
# hãy sao chép tệp này thành .env và điền thông tin phù hợp
# ========================================================

# 1. cấu hình máy chủ
PORT=5000
NODE_ENV=development
APP_NAME="Kết Nối Gia Sư & Học Viên"

# 2. địa chỉ máy chủ frontend (để cấp phép cors và nhận cookie)
CLIENT_URL=http://localhost:5173

# 3. chuỗi kết nối cơ sở dữ liệu mongodb
# có thể dùng mongodb local hoặc kết nối mongodb atlas đám mây
DB_URI=mongodb://127.0.0.1:27017/ket_noi_hv_gv

# 4. khóa bí mật mã hóa jwt (yêu cầu chuỗi dài ngẫu nhiên, bảo mật cao)
# access token có hiệu lực trong vòng 15 phút
JWT_SECRET=jwt_access_secret_key_sprint_1_dev_2026_very_secret_key
# refresh token có hiệu lực trong vòng 7 ngày
JWT_REFRESH_SECRET=jwt_refresh_secret_key_sprint_1_dev_2026_very_secret_key

# 5. khóa bí mật mã hóa dữ liệu nhạy cảm aes-256 (cccd, địa chỉ nhà)
# bắt buộc đúng 32 ký tự
ENCRYPTION_KEY=12345678901234567890123456789012

# 6. cấu hình dịch vụ gửi email smtp (ví dụ dùng gmail hoặc sendgrid)
# nếu để trống, hệ thống sẽ tự động in mã otp trực tiếp ra màn hình terminal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

